#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

struct Node *top = NULL;

void push(int x) {
    struct Node *new = malloc(sizeof(struct Node));

    new->data = x;
    new->next = top;
    top = new;

    printf("%d pushed into stack\n", x);
}

void pop() {
    if (top == NULL) {
        printf("Stack Underflow\n");
        return;
    }

    struct Node *d = top;
    printf("%d popped from stack\n", top->data);

    top = top->next;
    free(d);
}

void display() {
    if (top == NULL) {
        printf("Stack is empty\n");
        return;
    }

    struct Node *temp = top;

    printf("Stack: ");
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
    printf("\n");
}

void main() {
    push(10);
    push(20);
    push(30);

    display();

    pop();
    display();
}
